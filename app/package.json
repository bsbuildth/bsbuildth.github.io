{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\" && node scripts/build-sitemap.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bsbuildth \"node --test tests/rules.emulator.mjs\""
  },
  "dependencies": {
    "aos": "^2.3.4",
    "firebase": "^12.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-fast-marquee": "^1.6.5",
    "react-feather": "^2.0.10",
    "react-router-dom": "^7.15.1",
    "react-type-animation": "^3.2.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.29.0",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
